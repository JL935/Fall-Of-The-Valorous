                    <Setter Property="Text" TargetName="txt" Value="{Binding Source='h84d192f5g6473g4932gb6a8g1387eae58320',Converter={StaticResource TranslatedStringConverter}}" />
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>

