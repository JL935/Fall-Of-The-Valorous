function TargetSpellDC(fallbackDC, entity, ability)
    local entity = entity or context.Target
	local spellDC = fallbackDC or 10 -- Global default so that we don't return 0
    local ability = ability or context.PreferredCastingAbility
	if entity.IsValid then
        try
		    spellDC = CalculateSpellDC(ability, entity)
        catch e then
        end
	end
	return spellDC
end

function NegativeLevelDeathCheck(entity)
    local entity = entity or context.Target
    local charlevel = entity.Level
    local neglevel = GetStatusDuration('JL_FOTV_NEGATIVELEVEL', entity)
    return ConditionResult(neglevel >= charlevel)
end

function FrightfulPresenceImmuneCheck()
    local notscared = IsImmuneToStatus('SG_Frightened',context.Target)
    local despairaura = HasPassive('JL_FOTV_Ravener_AuraOfDespair',context.Source)
    if (not notscared.Result) or (notscared.Result and despairaura.Result) then
        st = SavingThrow(Ability.Wisdom,SourceSpellDC(),AdvantageOnFrightened(),DisadvantageOnFrightened())
        return ConditionResult(st.Result,{},{},st.Chance)
    elseif (notscared.Result) and (not despairaura.Result) then
        return ConditionResult(true)
    end
    return ConditionResult(false)
end

function VaelythraTargetConditions()
    local normalconditions = (Ally() & ~Dead()) | HasStatus('JL_FOTV_TAAROGUS_MINDCONTROL_4', context.Target)
    local soulconsumed = HasStatus('JL_FOTV_RAVENER_CONSUMPTION', context.Target)
    local ravenerdead = ~HasStatus('JL_FOTV_RAVENER_CONSUMPTION_BLOCK_VAELYTHRA',context.Target)
    if soulconsumed.Result then
        return ConditionResult(ravenerdead.Result, {ConditionError("SoulStillConsumed")})
    end
    return ConditionResult(normalconditions.Result, {ConditionError("MustBeAllyNotDead")})
end

function PotentLulixCheck(entity)
    local entity = entity or context.Target
    local potentenemy = Tagged('DRAGON',entity) | Tagged('FIEND',entity) | Tagged('UNDEAD',entity) | Tagged('UNDEAD_BEAST',entity)
    return ConditionResult(potentenemy.Result)
end

